DATABASE_URL=postgresql://chakravyuh:password@localhost:5432/chakravyuh
REDIS_URL=redis://localhost:6379/0
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder
CHROMA_PATH=/data/chakravyuh/vulndna_db
CVEFIXES_DB_PATH=
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
VULNDNA_COLLECTION=cve_patches
SCAN_DATA_ROOT=/data/chakravyuh/scans
SANDBOX_IMAGE=chakravyuh-sandbox:latest
SANDBOX_MODE=local
SYmCC_ENABLED=false
CODEQL_ENABLED=false

# Dev fallback when /data/chakravyuh is unavailable (Windows local testing)
# SCAN_DATA_ROOT=./data/scans

# CORS — comma-separated origins for React dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Stub pipeline stage delay (seconds) — Phase 0 dummy progression
PIPELINE_STAGE_DELAY_SEC=3
